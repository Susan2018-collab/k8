pipeline {
    agent any

    triggers {
        cron('H/10 * * * *') // every 10 minutes
    }

    parameters {
        choice(
            name: 'TARGET_ENV',
            choices: ['test', 'prod'],
            description: 'Select environment (default TEST via scheduler)'
        )
        booleanParam(
            name: 'FORCE_ROLLBACK',
            defaultValue: false,
            description: 'Trigger rollback manually'
        )
    }

    environment {
        IMAGE_NAME = "mail-server"
        TEST_CONT = "mail-test"
        PROD_CONT = "mail-prod"

        PRE_SCAN = "trivy-pre.json"
        POST_SCAN = "trivy-post.json"

        REPORT = "final-report.txt"
    }

    stages {

        stage('Init') {
            steps {
                script {
                    env.SELECTED_ENV = params.TARGET_ENV ?: "test"
                    echo "Selected ENV: ${env.SELECTED_ENV}"
                }
            }
        }

        stage('Pre Scan') {
            steps {
                sh """
                echo "Running PRE scan..."
                docker commit ${TEST_CONT} ${IMAGE_NAME}:pre
                trivy image --severity CRITICAL,HIGH --format json -o ${PRE_SCAN} ${IMAGE_NAME}:pre
                """
            }
        }

        stage('Extract CVE Details') {
            steps {
                script {
                    def json = readJSON file: "${PRE_SCAN}"

                    def vulns = []
                    json.Results.each { r ->
                        if (r.Vulnerabilities) {
                            r.Vulnerabilities.each {
                                vulns << "${it.VulnerabilityID} (${it.Severity}) - ${it.PkgName}"
                            }
                        }
                    }

                    env.CVE_COUNT = vulns.size().toString()
                    env.CVE_LIST = vulns.take(20).join("\n") // limit to avoid email overflow

                    writeFile file: "cve-list.txt", text: env.CVE_LIST
                }
            }
        }

        stage('Detect Upgradable Packages') {
            steps {
                script {
                    def upgrades = sh(
                        script: "docker exec ${TEST_CONT} apt list --upgradable 2>/dev/null | tail -n +2",
                        returnStdout: true
                    ).trim()

                    env.UPGRADE_COUNT = upgrades ? upgrades.split("\n").size().toString() : "0"
                    env.UPGRADE_LIST = upgrades.take(2000)

                    writeFile file: "upgrade-list.txt", text: env.UPGRADE_LIST
                }
            }
        }

        stage('Patch TEST') {
            when {
                expression { env.SELECTED_ENV == 'test' }
            }
            steps {
                sh "ansible-playbook patch.yml -l test"
            }
        }

        stage('Post Scan') {
            steps {
                sh """
                echo "Running POST scan..."
                docker commit ${TEST_CONT} ${IMAGE_NAME}:post
                trivy image --severity CRITICAL,HIGH --format json -o ${POST_SCAN} ${IMAGE_NAME}:post
                """
            }
        }

        stage('Compare CVEs') {
            steps {
                script {
                    def pre = readFile("${PRE_SCAN}")
                    def post = readFile("${POST_SCAN}")

                    env.CVE_DELTA = (pre.length() - post.length()).toString()
                }
            }
        }

        stage('Send Approval Email') {
            when {
                expression { env.SELECTED_ENV == 'test' }
            }
            steps {
                emailext(
                    subject: "SECURITY PATCH APPROVAL REQUIRED",
                    to: "susan.joffin@gmail.com",
                    body: """
========================================
SECURITY PATCH REPORT (TEST)

CVE DETECTED: ${env.CVE_COUNT}

Top CVEs:
${env.CVE_LIST}

PACKAGES TO UPGRADE: ${env.UPGRADE_COUNT}

${env.UPGRADE_LIST}

----------------------------------------
Do you approve deployment to PRODUCTION?
========================================
"""
                )
            }
        }

        stage('Manual Approval for PROD') {
            when {
                expression { env.SELECTED_ENV == 'test' }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve deployment to PRODUCTION?"
                }
            }
        }

        stage('Backup Before PROD') {
            when {
                anyOf {
                    expression { env.SELECTED_ENV == 'prod' }
                    expression { env.SELECTED_ENV == 'test' }
                }
            }
            steps {
                sh """
                echo "Creating PROD backup..."
                docker commit ${PROD_CONT} ${IMAGE_NAME}:backup
                """
            }
        }

        stage('Patch PROD') {
            when {
                anyOf {
                    expression { env.SELECTED_ENV == 'prod' }
                    expression { env.SELECTED_ENV == 'test' }
                }
            }
            steps {
                sh "ansible-playbook patch.yml -l prod"
            }
        }

        stage('Verify PROD') {
            steps {
                script {
                    def status = sh(
                        script: "docker exec ${PROD_CONT} systemctl is-active exim || true",
                        returnStdout: true
                    ).trim()

                    if (status != "active") {
                        error("Service DOWN after patch → triggering rollback")
                    }
                }
            }
        }

        stage('Rollback (if failure)') {
            when {
                expression { currentBuild.result == 'FAILURE' || params.FORCE_ROLLBACK }
            }
            steps {
                sh """
                echo "Rolling back PROD..."
                docker stop ${PROD_CONT} || true
                docker rm ${PROD_CONT} || true
                docker run -d --name ${PROD_CONT} ${IMAGE_NAME}:backup
                """
            }
        }

        stage('Post PROD Email') {
            steps {
                emailext(
                    subject: "PRODUCTION PATCH COMPLETED",
                    to: "susan.joffin@gmail.com",
                    body: """
========================================
PRODUCTION PATCH COMPLETED

CVE BEFORE PATCH: ${env.CVE_COUNT}
PACKAGES UPGRADED: ${env.UPGRADE_COUNT}

STATUS: SUCCESS

Rollback Available: YES
========================================
"""
                )
            }
        }
    }

    post {
        failure {
            emailext(
                subject: "PIPELINE FAILURE - ROLLBACK EXECUTED",
                to: "susan.joffin@gmail.com",
                body: "Pipeline failed. Rollback executed automatically."
            )
        }

        success {
            echo "Pipeline completed successfully"
        }
    }
}
