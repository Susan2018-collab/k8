pipeline {
    agent any

    parameters {
        string(name: 'EMAIL_TO', defaultValue: 'susan.joffin@gmail.com', description: 'Notification email')
        choice(name: 'ENV', choices: ['test', 'prod', 'all'], description: 'Target environment')
    }

    environment {
        ANSIBLE_DIR = "gitops-infrastructure-automation-platform/infrastructure/ansible"

        SCAN_REPORT = ""
        PATCH_REPORT = ""
        HIGH_VULN_FOUND = "false"

        APPROVAL_USER = ""
        APPROVAL_TIME = ""
    }

    stages {

        /* =========================
           CHECKOUT
        ========================= */
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        /* =========================
           SECURITY SCAN (TEST)
        ========================= */
        stage('Security Scan (Test)') {
            steps {
                script {
                    sh """
                    ansible-playbook \
                    -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                    ${ANSIBLE_DIR}/scan.yml \
                    --extra-vars "env=test"
                    """

                    if (fileExists('scan_report.txt')) {
                        env.SCAN_REPORT = readFile('scan_report.txt')

                        // BLOCK HIGH vulnerabilities
                        if (env.SCAN_REPORT.toLowerCase().contains("high")) {
                            env.HIGH_VULN_FOUND = "true"
                            error "HIGH severity vulnerabilities detected. Blocking pipeline."
                        }
                    }
                }
            }
        }

        /* =========================
           EMAIL: TEST SCAN REPORT
        ========================= */
        stage('Email Test Scan Report') {
            steps {
                script {
                    emailext(
                        to: params.EMAIL_TO.trim(),
                        subject: "TEST SCAN REPORT",
                        mimeType: 'text/plain',
                        body: """
Security scan completed for TEST environment.

SCAN REPORT:
----------------------------------------
${env.SCAN_REPORT}
----------------------------------------

Status: No HIGH vulnerabilities detected (if pipeline continued)

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
"""
                    )
                }
            }
        }

        /* =========================
           PATCH TEST
        ========================= */
        stage('Patch Test Environment') {
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=test"
                """

                if (fileExists('patch_report.txt')) {
                    env.PATCH_REPORT = readFile('patch_report.txt')
                }
            }
        }

        /* =========================
           EMAIL: TEST SUCCESS + APPROVAL LINK
        ========================= */
        stage('Email Test Success + Approval Link') {
            steps {
                script {
                    def approvalLink = "${env.BUILD_URL}input"

                    emailext(
                        to: params.EMAIL_TO.trim(),
                        subject: "TEST SUCCESS - APPROVAL REQUIRED FOR PRODUCTION",
                        mimeType: 'text/plain',
                        body: """
TEST environment patching completed successfully.

PATCH REPORT:
----------------------------------------
${env.PATCH_REPORT}
----------------------------------------

SCAN REPORT:
----------------------------------------
${env.SCAN_REPORT}
----------------------------------------

NEXT STEP:
Approve production deployment using link below:

${approvalLink}

OR go to Jenkins build → Click "Proceed"
"""
                    )
                }
            }
        }

        /* =========================
           APPROVAL (PROD GATE)
        ========================= */
        stage('Approval for Production') {
            steps {
                script {
                    env.APPROVAL_USER =
                        currentBuild.rawBuild.getCause(hudson.model.Cause$UserIdCause)?.userId ?: "auto"

                    env.APPROVAL_TIME = new Date().toString()

                    input message: "Approve deployment to PRODUCTION?"
                }
            }
        }

        /* =========================
           PATCH PRODUCTION
        ========================= */
        stage('Patch Production') {
            steps {
                script {
                    try {
                        sh """
                        ansible-playbook \
                        -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                        ${ANSIBLE_DIR}/patch.yml \
                        --extra-vars "env=prod"
                        """
                    } catch (Exception e) {
                        error "Production patch failed"
                    }
                }
            }
        }

        /* =========================
           ROLLBACK ON FAILURE
        ========================= */
        stage('Rollback (if failure)') {
            when {
                expression { currentBuild.currentResult == 'FAILURE' }
            }
            steps {
                script {
                    sh """
                    ansible-playbook \
                    -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                    ${ANSIBLE_DIR}/rollback.yml \
                    --extra-vars "env=prod"
                    """
                }
            }
        }
    }

    /* =========================
       FINAL EMAIL REPORT
    ========================= */
    post {

        success {
            emailext(
                to: params.EMAIL_TO.trim(),
                subject: "PRODUCTION DEPLOYMENT SUCCESS",
                mimeType: 'text/plain',
                body: """
Production deployment completed successfully.

APPROVAL DETAILS:
Approved By: ${env.APPROVAL_USER}
Approved At: ${env.APPROVAL_TIME}

SCAN SUMMARY:
----------------------------------------
${env.SCAN_REPORT}
----------------------------------------

PATCH SUMMARY:
----------------------------------------
${env.PATCH_REPORT}
----------------------------------------

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
"""
            )
        }

        failure {
            emailext(
                to: params.EMAIL_TO.trim(),
                subject: "PIPELINE FAILED / ROLLBACK EXECUTED",
                mimeType: 'text/plain',
                body: """
Pipeline failed or was blocked.

HIGH VULNERABILITY FLAG: ${env.HIGH_VULN_FOUND}

Rollback will be executed automatically if production was impacted.

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}

Check logs:
${env.BUILD_URL}
"""
            )
        }
    }
}
