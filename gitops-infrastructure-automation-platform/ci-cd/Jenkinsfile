pipeline {
    agent any

    triggers {
        cron('H/10 * * * *')
    }

    parameters {
        choice(
            name: 'ENV',
            choices: ['test', 'prod'],
            description: 'Select environment (default = test)'
        )
        booleanParam(
            name: 'FORCE_ROLLBACK',
            defaultValue: false,
            description: 'Trigger rollback manually'
        )
    }

    environment {
        TEST_CONTAINER = "mail-test"
        PROD_CONTAINER = "mail-prod"
        EMAIL = "susan.joffin@gmail.com"
    }

    stages {

        stage('Init') {
            steps {
                script {
                    env.TARGET_ENV = params.ENV ?: "test"
                    echo "Running in ENV: ${env.TARGET_ENV}"
                }
            }
        }

        stage('PRE Scan') {
            steps {
                sh '''
                docker commit ${TEST_CONTAINER} mail-server:pre
                trivy image --severity CRITICAL,HIGH --format json -o trivy-pre.json mail-server:pre
                '''
            }
        }

        stage('Extract CVE Data') {
            steps {
                script {
                    env.CVE_COUNT = sh(
                        script: "jq '[.Results[].Vulnerabilities[]?] | length' trivy-pre.json",
                        returnStdout: true
                    ).trim()

                    env.CVE_LIST = sh(
                        script: "jq -r '.Results[].Vulnerabilities[]? | \"\\(.VulnerabilityID) - \\(.PkgName)\"' trivy-pre.json | head -20",
                        returnStdout: true
                    ).trim()

                    echo "CVE Count: ${env.CVE_COUNT}"
                }
            }
        }

        stage('Detect Upgradable Packages') {
            steps {
                script {
                    env.UPGRADE_COUNT = sh(
                        script: "docker exec ${TEST_CONTAINER} bash -c \"apt list --upgradable 2>/dev/null | wc -l\"",
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Patch TEST') {
            steps {
                sh '''
                docker exec ${TEST_CONTAINER} apt update
                docker exec ${TEST_CONTAINER} apt upgrade -y
                '''
            }
        }

        stage('Post Scan') {
            steps {
                sh '''
                docker commit ${TEST_CONTAINER} mail-server:post
                trivy image --severity CRITICAL,HIGH --format json -o trivy-post.json mail-server:post
                '''
            }
        }

        stage('Compare CVEs') {
            steps {
                script {
                    env.POST_CVE = sh(
                        script: "jq '[.Results[].Vulnerabilities[]?] | length' trivy-post.json",
                        returnStdout: true
                    ).trim()

                    echo "POST CVE Count: ${env.POST_CVE}"
                }
            }
        }

        stage('Decision Gate') {
            steps {
                script {
                    if (env.POST_CVE.toInteger() == 0) {
                        env.AUTO_PROMOTE = "true"
                        echo "No CVEs → Auto promote to PROD"
                    } else {
                        env.AUTO_PROMOTE = "false"
                        echo "CVEs still exist → Approval required"
                    }
                }
            }
        }

        stage('Approval Email') {
            when {
                expression { env.AUTO_PROMOTE == "false" }
            }
            steps {
                emailext(
                    to: "${EMAIL}",
                    subject: "APPROVAL REQUIRED - CVE PATCH REPORT",
                    body: """
PRE-CVE: ${env.CVE_COUNT}
POST-CVE: ${env.POST_CVE}
Packages: ${env.UPGRADE_COUNT}

Top CVEs:
${env.CVE_LIST}

Approve PROD deployment in Jenkins.
"""
                )
            }
        }

        stage('Manual Approval') {
            when {
                expression { env.AUTO_PROMOTE == "false" }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve PROD patch?"
                }
            }
        }

        stage('Force Rollback (Manual)') {
            when {
                expression { params.FORCE_ROLLBACK == true }
            }
            steps {
                sh '''
                echo "Manual rollback triggered..."
                docker stop ${PROD_CONTAINER} || true
                docker rm ${PROD_CONTAINER} || true
                docker run -d --name ${PROD_CONTAINER} mail-prod:backup
                '''
            }
        }

        stage('Backup PROD') {
            steps {
                sh 'docker commit ${PROD_CONTAINER} mail-prod:backup'
            }
        }

        stage('Patch PROD') {
            steps {
                sh '''
                docker exec ${PROD_CONTAINER} apt update
                docker exec ${PROD_CONTAINER} apt upgrade -y
                '''
            }
        }

        stage('Verify PROD') {
            steps {
                script {
                    def status = sh(
                        script: "docker exec ${PROD_CONTAINER} systemctl is-active exim || true",
                        returnStdout: true
                    ).trim()

                    if (status != "active") {
                        error("Service failed after patch")
                    }
                }
            }
        }

        stage('Rollback (Auto if failure)') {
            when {
                expression { currentBuild.currentResult == 'FAILURE' }
            }
            steps {
                sh '''
                echo "Auto rollback..."
                docker stop ${PROD_CONTAINER} || true
                docker rm ${PROD_CONTAINER} || true
                docker run -d --name ${PROD_CONTAINER} mail-prod:backup
                '''
            }
        }

        stage('PROD Success Email') {
            steps {
                emailext(
                    to: "${EMAIL}",
                    subject: "PROD PATCH SUCCESS",
                    body: """
Production patch completed.

CVE Before: ${env.CVE_COUNT}
CVE After: ${env.POST_CVE}
Packages Upgraded: ${env.UPGRADE_COUNT}

Status: SUCCESS
"""
                )
            }
        }
    }

    post {
        failure {
            emailext(
                to: "${EMAIL}",
                subject: "PIPELINE FAILED",
                body: "Pipeline failed. Check logs."
            )
        }
    }
}
