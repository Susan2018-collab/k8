pipeline {
    agent any

    parameters {
        string(name: 'EMAIL_TO', defaultValue: 'susan.joffin@gmail.com', description: 'Notification email')
        choice(name: 'ENV', choices: ['test', 'prod', 'all'], description: 'Target environment')
    }

    triggers {
        cron('H/10 * * * *')
    }

    environment {
        ANSIBLE_DIR = "gitops-infrastructure-automation-platform/infrastructure/ansible"
    }

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Security Scan (Ansible)') {
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/scan.yml \
                --extra-vars "env=${params.ENV}"
                """
            }
        }

        stage('Evaluate Scan Result') {
            steps {
                script {
                    echo "Evaluating scan results..."
                    // Replace with real logic later
                    env.PATCH_FOUND = "true"
                }
            }
        }

        stage('Notify - Patch Found') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                echo "Patches detected, starting remediation pipeline"
            }
        }

        stage('Patch Test Environment') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=test"
                """
            }
        }

        stage('Validate Test Environment') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh "echo 'Running health checks on TEST environment'"
            }
        }

        stage('Send Test Success Email') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                script {
                    emailext(
                        to: params.EMAIL_TO.trim(),
                        subject: "TEST PATCH SUCCESS",
                        body: """Test environment patching completed successfully.

Environment: TEST
Status: SUCCESS

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
""",
                        mimeType: 'text/plain'
                    )
                }
            }
        }

        stage('Approval for Production') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                input message: "TEST is successful. Approve deployment to PRODUCTION?"
            }
        }

        stage('Patch Production') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=prod"
                """
            }
        }
    }

    post {

        always {
            echo "Pipeline completed. Email target: ${params.EMAIL_TO}"
        }

        success {
            emailext(
                to: params.EMAIL_TO.trim(),
                subject: "DAILY SECURITY SCAN SUCCESS",
                body: """Pipeline completed successfully.

Environment: ${params.ENV}
Status: SUCCESS

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
""",
                mimeType: 'text/plain'
            )
        }

        failure {
            emailext(
                to: params.EMAIL_TO.trim(),
                subject: "DAILY SECURITY SCAN FAILED",
                body: """Pipeline execution failed.

Environment: ${params.ENV}
Status: FAILED

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}

Check Jenkins logs immediately.
""",
                mimeType: 'text/plain'
            )
        }
    }
}
