pipeline {
    agent any

    parameters {
        string(name: 'EMAIL_TO', defaultValue: 'susan.joffin@gmail.com', description: 'Notification Email')
        choice(name: 'ENV', choices: ['test', 'prod', 'all'], description: 'Target Environment')
    }

    triggers {
        cron('H 2 * * *')   // daily
    }

    environment {
        ANSIBLE_DIR = "gitops-infrastructure-automation-platform/infrastructure/ansible"
    }

    stages {

        // =====================================================
        // 1. CHECKOUT
        // =====================================================
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        // =====================================================
        // 2. SECURITY SCAN
        // =====================================================
        stage('Security Scan') {
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/scan.yml \
                --extra-vars "env=${params.ENV} email_to=${params.EMAIL_TO}"
                """
            }
        }

        // =====================================================
        // 3. EVALUATE
        // =====================================================
        stage('Evaluate Scan Result') {
            steps {
                script {
                    echo "Evaluating scan results..."
                    env.PATCH_FOUND = "true"   // TODO: replace with real parsing
                }
            }
        }

        // =====================================================
        // 4. ARCHIVE SCAN REPORT
        // =====================================================
        stage('Archive Scan Reports') {
            steps {
                archiveArtifacts artifacts: '**/scan_*.txt', allowEmptyArchive: true
            }
        }

        // =====================================================
        // 5. PATCH TEST
        // =====================================================
        stage('Patch TEST Environment') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=test"
                """
            }
        }

        // =====================================================
        // 6. TEST SUCCESS EMAIL
        // =====================================================
        stage('Notify TEST Success') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                emailext(
                    to: "${params.EMAIL_TO}",
                    subject: "✅ TEST PATCH SUCCESS",
                    body: """\
Test patching completed successfully.

Environment: TEST
Status: SUCCESS

Proceeding to approval stage.
""",
                    mimeType: 'text/plain'
                )
            }
        }

        // =====================================================
        // 7. SEND APPROVAL EMAIL (WITH LINK)
        // =====================================================
        stage('Send Approval Email') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                script {
                    def approvalLink = "${env.BUILD_URL}input"

                    emailext(
                        to: "${params.EMAIL_TO}",
                        subject: "⚠️ APPROVAL REQUIRED: Production Deployment",
                        mimeType: 'text/html',
                        body: """
                        <html>
                        <body>
                            <h2>Approval Required for Production Deployment</h2>

                            <p><b>Job:</b> ${env.JOB_NAME}</p>
                            <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
                            <p><b>Environment:</b> ${params.ENV}</p>

                            <p>Test patching completed successfully.</p>

                            <p>
                                👉 <a href="${approvalLink}">
                                Click here to APPROVE Production Deployment
                                </a>
                            </p>

                            <br/>
                            <p>If not approved, deployment will not proceed.</p>

                            <hr/>
                            <p>Jenkins Pipeline</p>
                        </body>
                        </html>
                        """
                    )
                }
            }
        }

        // =====================================================
        // 8. APPROVAL GATE
        // =====================================================
        stage('Approval for Production') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve deployment to PRODUCTION?"
                }
            }
        }

        // =====================================================
        // 9. PATCH PROD
        // =====================================================
        stage('Patch PROD Environment') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=prod"
                """
            }
        }

        // =====================================================
        // 10. ARCHIVE PATCH REPORT
        // =====================================================
        stage('Archive Patch Reports') {
            steps {
                archiveArtifacts artifacts: '**/patch_report_*.txt', allowEmptyArchive: true
            }
        }
    }

    // =====================================================
    // POST
    // =====================================================
    post {

        always {
            echo "Pipeline completed. Email target: ${params.EMAIL_TO}"
        }

        success {
            emailext(
                to: "${params.EMAIL_TO}",
                subject: "✅ PIPELINE SUCCESS",
                body: """\
Pipeline completed successfully.

Environment: ${params.ENV}
Status: SUCCESS

Check Jenkins for logs.
""",
                mimeType: 'text/plain'
            )
        }

        failure {
            emailext(
                to: "${params.EMAIL_TO}",
                subject: "❌ PIPELINE FAILED",
                body: """\
Pipeline FAILED.

Environment: ${params.ENV}

Check Jenkins immediately.
""",
                mimeType: 'text/plain'
            )
        }
    }
}
