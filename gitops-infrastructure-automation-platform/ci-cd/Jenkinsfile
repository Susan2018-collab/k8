pipeline {
    agent any

    parameters {
        string(name: 'EMAIL_TO', defaultValue: 'susan.joffin@gmail.com', description: 'Notification email')
    }

    triggers {
        cron('H/10 * * * *')
    }

    environment {
        ANSIBLE_DIR = "gitops-infrastructure-automation-platform/infrastructure/ansible"
        PATCH_FOUND = "false"
    }

    stages {

        // 1. SECURITY SCAN
        stage('Scan for Security Updates') {
            steps {
                script {
                    def scanOutput = sh(
                        script: """
                        ansible-playbook \
                        -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                        ${ANSIBLE_DIR}/scan.yml
                        """,
                        returnStdout: true
                    ).trim()

                    echo "${scanOutput}"

                    // SIMPLE DETECTION LOGIC (replace later with real parsing)
                    if (scanOutput.contains("changed") || scanOutput.contains("upgraded")) {
                        env.PATCH_FOUND = "true"
                    } else {
                        env.PATCH_FOUND = "false"
                    }
                }
            }
        }

        // 2. NOTIFY IF PATCH FOUND
        stage('Notify Patch Found') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                echo "Patches detected. Starting test environment remediation." | \
                mail -s "PATCH ALERT - TEST ENV" ${params.EMAIL_TO}
                """
            }
        }

        // 3. PATCH TEST ENVIRONMENT
        stage('Patch Test Environment') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patching.yml \
                --extra-vars "env=test email_to=${params.EMAIL_TO}"
                """
            }
        }

        // 4. VALIDATE TEST
        stage('Validate Test Environment') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh "echo 'Running health checks on TEST environment'"
            }
        }

        // 5. TEST SUCCESS EMAIL
        stage('Test Success Notification') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                echo "Test environment patched and validated successfully." | \
                mail -s "TEST PATCH SUCCESS" ${params.EMAIL_TO}
                """
            }
        }

        // 6. APPROVAL GATE
        stage('Approval for Production') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                input message: "TEST successful. Approve deployment to PROD?"
            }
        }

        // 7. PATCH PROD
        stage('Patch Production') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patching.yml \
                --extra-vars "env=prod email_to=${params.EMAIL_TO}"
                """
            }
        }

        // 8. FINAL EMAIL
        stage('Final Notification') {
            steps {
                sh """
                echo "Production patching completed successfully." | \
                mail -s "PRODUCTION PATCH COMPLETE" ${params.EMAIL_TO}
                """
            }
        }
    }
}
