pipeline {
    agent any

    triggers {
        cron('H/10 * * * *')
    }

    parameters {
        choice(name: 'ENV', choices: ['TEST', 'BOTH', 'PROD'], description: 'Default TEST')
        string(name: 'EXCLUDE_CVES', defaultValue: '', description: 'Comma-separated CVEs to ignore')
        booleanParam(name: 'FORCE_ROLLBACK', defaultValue: false, description: 'Force rollback')
    }

    environment {
        EMAIL = "susan.joffin@gmail.com"
    }

    stages {

        stage('Set ENV') {
            steps {
                script {
                    env.SELECTED_ENV = params.ENV ?: "TEST"
                }
            }
        }

        stage('PRE SCAN') {
            steps {
                sh '''
                docker commit mail-test mail-pre
                trivy image --severity CRITICAL,HIGH -f json -o pre.json mail-pre
                '''
            }
        }

        stage('Extract CVEs') {
            steps {
                sh '''
                apt-get update -y && apt-get install -y jq

                jq -r '.Results[].Vulnerabilities[].VulnerabilityID' pre.json | sort -u > pre_cves.txt || true
                echo $(cat pre_cves.txt | wc -l) > pre_count.txt
                '''
                script {
                    env.PRE_COUNT = readFile('pre_count.txt').trim()
                    env.TOP_CVES = sh(script: "head -20 pre_cves.txt", returnStdout: true)
                }
            }
        }

        stage('Detect Packages') {
            steps {
                sh '''
                apt list --upgradable 2>/dev/null | tail -n +2 | awk -F/ '{print $1}' > packages.txt || true
                echo $(cat packages.txt | wc -l) > pkg_count.txt
                '''
                script {
                    env.PKG_COUNT = readFile('pkg_count.txt').trim()
                    env.PACKAGES = readFile('packages.txt')
                }
            }
        }

        stage('PATCH TEST') {
            when { expression { env.SELECTED_ENV in ["TEST","BOTH"] } }
            steps {
                sh 'ansible-playbook patch.yaml -i inventory/test | tee test_output.txt'
            }
        }

        stage('Extract Test Report') {
            steps {
                script {
                    def log = readFile('test_output.txt')

                    env.EXIM_STATUS = log.contains("Exim Running: active") ? "RUNNING" : "FAILED"
                    env.SMTP_STATUS = log.contains("SMTP Port: OPEN") ? "OPEN" : "CLOSED"
                    env.MAIL_STATUS = log.contains("Mail Sent: True") || log.contains("Mail Sent: true") ? "SUCCESS" : "FAILED"

                    env.MAIL_LOG = sh(script: "grep -A5 'MAIL LOGS:' test_output.txt | tail -n 5", returnStdout: true)
                }
            }
        }

        stage('POST SCAN') {
            steps {
                sh '''
                docker commit mail-test mail-post
                trivy image --severity CRITICAL,HIGH -f json -o post.json mail-post

                jq -r '.Results[].Vulnerabilities[].VulnerabilityID' post.json | sort -u > post_cves.txt || true
                echo $(cat post_cves.txt | wc -l) > post_count.txt
                '''
                script {
                    env.POST_COUNT = readFile('post_count.txt').trim()
                }
            }
        }

        stage('CVE ANALYSIS') {
            steps {
                sh '''
                comm -23 pre_cves.txt post_cves.txt > fixed.txt || true
                comm -12 pre_cves.txt post_cves.txt > unfixed.txt || true

                echo "${EXCLUDE_CVES}" | tr ',' '\\n' > excluded.txt || true
                comm -23 unfixed.txt excluded.txt > blocking.txt || true
                '''
                script {
                    env.FIXED_COUNT = sh(script: "cat fixed.txt | wc -l", returnStdout: true).trim()
                    env.BLOCKING = sh(script: "cat blocking.txt | wc -l", returnStdout: true).trim()
                }
            }
        }

        stage('Approval Email') {
            when { expression { env.BLOCKING != "0" } }
            steps {
                script {

                    def html = """
                    <html><body style="font-family:Arial;background:#f4f6f8;">
                    <div style="background:#2c3e50;color:white;padding:15px;">
                    <h2>🚀 Patch Report</h2></div>

                    <h3>🔐 CVE Summary</h3>
                    <table border="1" cellpadding="5">
                    <tr><td>PRE</td><td>${env.PRE_COUNT}</td></tr>
                    <tr><td>POST</td><td>${env.POST_COUNT}</td></tr>
                    <tr><td>FIXED</td><td style="color:green">${env.FIXED_COUNT}</td></tr>
                    <tr><td>BLOCKING</td><td style="color:red">${env.BLOCKING}</td></tr>
                    </table>

                    <h3>⚠️ Top CVEs</h3>
                    <pre>${env.TOP_CVES}</pre>

                    <h3>📦 Packages (${env.PKG_COUNT})</h3>
                    <pre>${env.PACKAGES}</pre>

                    <h3>📡 Service</h3>
                    <table border="1">
                    <tr><td>Exim</td><td>${env.EXIM_STATUS}</td></tr>
                    <tr><td>SMTP</td><td>${env.SMTP_STATUS}</td></tr>
                    <tr><td>Mail</td><td>${env.MAIL_STATUS}</td></tr>
                    </table>

                    <h3>📨 Mail Logs</h3>
                    <pre>${env.MAIL_LOG}</pre>

                    <a href="${env.BUILD_URL}input" style="background:blue;color:white;padding:10px;">
                    Approve PROD</a>

                    </body></html>
                    """

                    emailext(
                        to: "${env.EMAIL}",
                        subject: "⚠ Approval Required",
                        mimeType: 'text/html',
                        body: html
                    )
                }
            }
        }

        stage('Approval') {
            when { expression { env.BLOCKING != "0" } }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve PROD?"
                }
            }
        }

        stage('Auto Promote') {
            when { expression { env.BLOCKING == "0" } }
            steps {
                echo "Auto promoting to PROD"
            }
        }
           stages {

        /* =========================
           🔐 TRIVY SECURITY SCAN
        ========================= */
        stage('Trivy Scan PROD') {
            when { expression { env.SELECTED_ENV in ["PROD", "BOTH"] } }
            steps {
                script {
                    echo "Running Trivy scan on PROD..."

                    def scanStatus = sh(
                        script: """
                        trivy fs --exit-code 1 --severity HIGH,CRITICAL \
                        --format json -o trivy-prod-report.json . || true
                        """,
                        returnStatus: true
                    )

                    if (scanStatus != 0) {
                        currentBuild.result = 'UNSTABLE'
                        echo "⚠️ Vulnerabilities found in PROD scan"
                    }
                }
            }
        }

        /* =========================
           🟡 MANUAL APPROVAL
        ========================= */
        stage('Approval PROD') {
            when { expression { env.SELECTED_ENV in ["PROD", "BOTH"] } }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve PROD deployment after Trivy scan?"
                }
            }
        }

        /* =========================
           🚀 PATCH PROD
        ========================= */
        stage('PATCH PROD') {
            when { expression { env.SELECTED_ENV in ["PROD", "BOTH"] } }
            steps {
                script {
                    echo "Applying patches to PROD servers..."

                    sh '''
                    ansible-playbook patch.yaml -i inventory/hosts.ini
                    '''
                }
            }
        }

        /* =========================
           🔍 POST VALIDATION
        ========================= */
        stage('Post Validation PROD') {
            when { expression { env.SELECTED_ENV in ["PROD", "BOTH"] } }
            steps {
                script {
                    echo "Running post-patch validation..."

                    sh '''
                    ./healthcheck.sh || exit 1
                    '''
                }
            }
        }

        /* =========================
           🔁 ROLLBACK (FAIL SAFE)
        ========================= */
        stage('Rollback PROD') {
            when {
                expression {
                    currentBuild.currentResult == "FAILURE"
                }
            }
            steps {
                script {
                    echo "Rollback triggered..."

                    sh '''
                    docker stop mail-prod || true
                    docker rm mail-prod || true
                    docker run -d --name mail-prod backup-image
                    '''
                }
            }
        }

        /* =========================
           📧 FINAL EMAIL REPORT
        ========================= */
        stage('Final Email PROD') {
            steps {
                script {

                    emailext(
                        to: "${env.EMAIL}",
                        subject: "🚀 PROD Patch Report - ${currentBuild.currentResult}",
                        mimeType: 'text/html',
                        attachmentsPattern: 'trivy-prod-report.json',
                        body: """
                        <h2>PROD PATCH EXECUTION REPORT</h2>

                        <p><b>Status:</b> ${currentBuild.currentResult}</p>

                        <h3>Security Scan (Trivy)</h3>
                        <p>Report attached: trivy-prod-report.json</p>

                        <h3>System Metrics</h3>
                        <p>PRE Check: ${env.PRE_COUNT}</p>
                        <p>POST Check: ${env.POST_COUNT}</p>
                        <p>FIXED: ${env.FIXED_COUNT}</p>

                        <h3>Services</h3>
                        <p>Exim: ${env.EXIM_STATUS}</p>
                        <p>Mail: ${env.MAIL_STATUS}</p>

                        <hr>
                        <p><b>Note:</b> Pipeline includes Trivy security gate + patch automation + validation</p>
                        """
                    )
                }
            }
        }
    }
}
