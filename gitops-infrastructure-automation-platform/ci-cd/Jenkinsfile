pipeline {
    agent any

    parameters {
        string(name: 'EMAIL_TO', defaultValue: 'susan.joffin@gmail.com', description: 'DevOps notification email')
        choice(name: 'ENV', choices: ['test', 'prod', 'all'], description: 'Target environment')
    }

    triggers {
        cron('H/10 * * * *')
    }

    environment {
        BASE_DIR = "gitops-infrastructure-automation-platform"
        ANSIBLE_DIR = "${BASE_DIR}/infrastructure/ansible"
    }

    stages {

        /* =========================
           1. SECURITY SCAN
        ========================== */
        stage('Security Scan') {
            steps {
                script {
                    def scanOutput = sh(
                        script: """
                        ansible-playbook \
                        -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                        ${ANSIBLE_DIR}/scan.yml
                        """,
                        returnStdout: true
                    )

                    echo "${scanOutput}"

                    if (scanOutput.contains("upgraded") || scanOutput.contains("changed")) {
                        env.PATCH_FOUND = "true"
                    } else {
                        env.PATCH_FOUND = "false"
                    }
                }
            }
        }

        /* =========================
           2. NOTIFY PATCH FOUND
        ========================== */
        stage('Notify Patch Found') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                echo "Security patches detected on servers. Starting test remediation." | \
                mail -s "PATCH ALERT - TEST ENV" ${params.EMAIL_TO}
                """
            }
        }

        /* =========================
           3. PATCH TEST ENV
        ========================== */
        stage('Patch Test Environment') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patching.yml \
                --extra-vars "env=test email_to=${params.EMAIL_TO}"
                """
            }
        }

        /* =========================
           4. TEST VALIDATION
        ========================== */
        stage('Validate Test Environment') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                echo "Running health checks on TEST environment..."
                """
            }
        }

        /* =========================
           5. TEST SUCCESS EMAIL
        ========================== */
        stage('Test Success Notification') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                echo "Test environment patched successfully and validated." | \
                mail -s "TEST PATCH SUCCESS" ${params.EMAIL_TO}
                """
            }
        }

        /* =========================
           6. APPROVAL GATE
        ========================== */
        stage('Approval for Production') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                input message: "Test successful. Approve deployment to PRODUCTION?"
            }
        }

        /* =========================
           7. PATCH PROD
        ========================== */
        stage('Patch Production') {
            when {
                expression { env.PATCH_FOUND == "true" }
            }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patching.yml \
                --extra-vars "env=prod email_to=${params.EMAIL_TO}"
                """
            }
        }

        /* =========================
           8. FINAL NOTIFICATION
        ========================== */
        stage('Final Notification') {
            steps {
                sh """
                echo "Production patching completed successfully." | \
                mail -s "PRODUCTION PATCH COMPLETE" ${params.EMAIL_TO}
                """
            }
        }
    }
}
