import groovy.json.JsonSlurper

pipeline {
    agent any

    parameters {
        string(name: 'EMAIL_TO', defaultValue: 'susan.joffin@gmail.com', description: 'Notification Email')
    }

    triggers {
        cron('H 2 * * *')
    }

    environment {
        ANSIBLE_DIR = "gitops-infrastructure-automation-platform/infrastructure/ansible"

        CONTAINER_TEST = "mail-test"
        CONTAINER_PROD = "mail-prod"

        BACKUP_IMAGE_TEST = "mail-test-backup"
        BACKUP_IMAGE_PROD = "mail-prod-backup"
    }

    stages {

        // =====================================================
        // 1. Checkout
        // =====================================================
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // =====================================================
        // 2. TEST: Backup + Patch + Scan
        // =====================================================
        stage('TEST: Backup + Patch + Scan') {
            steps {
                sh """
                echo "Backing up TEST..."
                docker commit ${CONTAINER_TEST} ${BACKUP_IMAGE_TEST} || true

                echo "Running TEST patch..."
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=test"
                """

                sh """
                echo "Running Trivy scan (TEST)..."
                trivy image \
                    --format json \
                    -o trivy-test.json \
                    ${CONTAINER_TEST} || true

                trivy image \
                    --format template \
                    --template "@contrib/html.tpl" \
                    -o trivy-test.html \
                    ${CONTAINER_TEST} || true
                """
            }
        }

        // =====================================================
        // 3. Parse TEST CVE Report
        // =====================================================
        stage('Parse TEST CVE Report') {
            steps {
                script {

                    def json = readFile("trivy-test.json")
                    def parsed = new JsonSlurper().parseText(json)

                    int critical = 0
                    int high = 0
                    int medium = 0
                    int low = 0

                    parsed.Results.each { r ->
                        r.Vulnerabilities?.each { v ->
                            switch(v.Severity) {
                                case "CRITICAL": critical++; break
                                case "HIGH": high++; break
                                case "MEDIUM": medium++; break
                                case "LOW": low++; break
                            }
                        }
                    }

                    env.TEST_CVE_SUMMARY = """
CRITICAL: ${critical}
HIGH: ${high}
MEDIUM: ${medium}
LOW: ${low}
"""
                }
            }
        }

        // =====================================================
        // 4. TEST Email + Approval Link
        // =====================================================
        stage('Send TEST Report + PROD Approval Link') {
            steps {
                script {

                    def approvalLink = "${env.BUILD_URL}input"

                    emailext(
                        to: "${params.EMAIL_TO}",
                        subject: "🧪 TEST COMPLETE - APPROVAL FOR PROD REQUIRED",
                        mimeType: 'text/html',

                        body: """
<h2>🧪 TEST ENVIRONMENT REPORT</h2>

<h3>🔐 CVE Summary</h3>
<pre>${env.TEST_CVE_SUMMARY}</pre>

<h3>🛠 What was done</h3>
<ul>
<li>Backup created</li>
<li>Patches applied (TEST)</li>
<li>Trivy scan executed</li>
</ul>

<h3>🚦 Next Step</h3>
<p>Approve production deployment:</p>

<a href="${approvalLink}" style="padding:10px 15px;background:#28a745;color:white;text-decoration:none;">
👉 APPROVE PROD DEPLOYMENT
</a>

<p>This approval triggers production patching.</p>
""",

                        attachmentsPattern: """
trivy-test.html,
trivy-test.json
"""
                    )
                }
            }
        }

        // =====================================================
        // 5. PROD APPROVAL GATE
        // =====================================================
        stage('PROD Approval Gate') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve deployment to PRODUCTION?"
                }
            }
        }

        // =====================================================
        // 6. PROD Backup + Patch + Scan
        // =====================================================
        stage('PROD: Backup + Patch + Scan') {
            steps {
                sh """
                echo "Backing up PROD..."
                docker commit ${CONTAINER_PROD} ${BACKUP_IMAGE_PROD} || true

                echo "Running PROD patch..."
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=prod"
                """

                sh """
                echo "Running Trivy scan (PROD BLOCKING)..."
                trivy image \
                    --exit-code 1 \
                    --severity HIGH,CRITICAL \
                    --format json \
                    -o trivy-prod.json \
                    ${CONTAINER_PROD}

                trivy image \
                    --format template \
                    --template "@contrib/html.tpl" \
                    -o trivy-prod.html \
                    ${CONTAINER_PROD}
                """
            }
        }

        // =====================================================
        // 7. Parse PROD CVE
        // =====================================================
        stage('Parse PROD CVE') {
            steps {
                script {

                    def json = readFile("trivy-prod.json")
                    def parsed = new JsonSlurper().parseText(json)

                    int critical = 0
                    int high = 0
                    int medium = 0
                    int low = 0

                    parsed.Results.each { r ->
                        r.Vulnerabilities?.each { v ->
                            switch(v.Severity) {
                                case "CRITICAL": critical++; break
                                case "HIGH": high++; break
                                case "MEDIUM": medium++; break
                                case "LOW": low++; break
                            }
                        }
                    }

                    env.PROD_CVE_SUMMARY = """
CRITICAL: ${critical}
HIGH: ${high}
MEDIUM: ${medium}
LOW: ${low}
"""
                }
            }
        }

        // =====================================================
        // 8. PROD Email Report
        // =====================================================
        stage('Send PROD Report') {
            steps {
                emailext(
                    to: "${params.EMAIL_TO}",
                    subject: "🏭 PROD DEPLOYMENT REPORT",
                    mimeType: 'text/html',

                    body: """
<h2>🏭 PRODUCTION DEPLOYMENT COMPLETE</h2>

<h3>🔐 CVE Summary</h3>
<pre>${env.PROD_CVE_SUMMARY}</pre>

<h3>🛠 Actions Taken</h3>
<ul>
<li>Patches applied in PROD</li>
<li>Security scan executed (Trivy)</li>
</ul>

<h3>🚦 Policy</h3>
<p>PROD = BLOCK HIGH/CRITICAL vulnerabilities</p>
""",

                    attachmentsPattern: """
trivy-prod.html,
trivy-prod.json
"""
                )
            }
        }
    }

    // =====================================================
    // POST (ROLLBACK)
    // =====================================================
    post {
        failure {
            sh """
            docker stop ${CONTAINER_TEST} || true
            docker rm ${CONTAINER_TEST} || true
            docker run -d --name ${CONTAINER_TEST} ${BACKUP_IMAGE_TEST} || true

            docker stop ${CONTAINER_PROD} || true
            docker rm ${CONTAINER_PROD} || true
            docker run -d --name ${CONTAINER_PROD} ${BACKUP_IMAGE_PROD} || true
            """

            emailext(
                to: "${params.EMAIL_TO}",
                subject: "❌ PIPELINE FAILED - ROLLBACK EXECUTED",
                body: "Rollback executed. Check Jenkins logs."
            )
        }
    }
}
