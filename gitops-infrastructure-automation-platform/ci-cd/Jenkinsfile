import groovy.json.JsonSlurper

pipeline {
    agent any

    parameters {
        string(name: 'EMAIL_TO', defaultValue: 'susan.joffin@gmail.com', description: 'Notification Email')
    }

    triggers {
        cron('H 2 * * *')
    }

    environment {
        ANSIBLE_DIR = "gitops-infrastructure-automation-platform/infrastructure/ansible"

        CONTAINER_TEST = "mail-test"
        CONTAINER_PROD = "mail-prod"

        BACKUP_IMAGE_TEST = "mail-test-backup"
        BACKUP_IMAGE_PROD = "mail-prod-backup"
    }

    stages {

        // =====================================================
        // Checkout
        // =====================================================
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // =====================================================
        // Install Trivy (FIXED)
        // =====================================================
        stage('Install Trivy') {
            steps {
                sh """
                set -e

                if ! command -v trivy >/dev/null 2>&1; then
                    echo "Installing Trivy..."

                    apt-get update -y || true
                    apt-get install -y curl || true

                    curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh \
                    | sh -s -- -b /usr/local/bin
                fi

                trivy --version
                """
            }
        }

        // =====================================================
        // TEST: Backup + Patch
        // =====================================================
        stage('TEST Patch + Backup') {
            steps {
                sh """
                echo "Backup TEST"
                docker commit ${CONTAINER_TEST} ${BACKUP_IMAGE_TEST} || true

                echo "Patch TEST"
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=test"
                """
            }
        }

        // =====================================================
        // TEST: Trivy Scan
        // =====================================================
        stage('TEST Trivy Scan') {
            steps {
                sh """
                trivy image \
                    --format json \
                    -o trivy-test.json \
                    ${CONTAINER_TEST} || true

                trivy image \
                    --format template \
                    --template "@contrib/html.tpl" \
                    -o trivy-test.html \
                    ${CONTAINER_TEST} || true
                """
            }
        }

        // =====================================================
        // Parse TEST CVE (SAFE)
        // =====================================================
        stage('Parse TEST CVE') {
            steps {
                script {

                    if (!fileExists("trivy-test.json")) {
                        env.TEST_CVE_SUMMARY = "No scan data available"
                        return
                    }

                    def json = readFile("trivy-test.json")
                    def parsed = new JsonSlurper().parseText(json)

                    int critical = 0
                    int high = 0
                    int medium = 0
                    int low = 0

                    parsed.Results.each { r ->
                        r.Vulnerabilities?.each { v ->
                            switch(v.Severity) {
                                case "CRITICAL": critical++; break
                                case "HIGH": high++; break
                                case "MEDIUM": medium++; break
                                case "LOW": low++; break
                            }
                        }
                    }

                    env.TEST_CVE_SUMMARY = """
CRITICAL: ${critical}
HIGH: ${high}
MEDIUM: ${medium}
LOW: ${low}
"""
                }
            }
        }

        // =====================================================
        // TEST Email + PROD Approval Link
        // =====================================================
        stage('Send TEST Report + Approval') {
            steps {
                script {

                    def approvalLink = "${env.BUILD_URL}input"

                    emailext(
                        to: "${params.EMAIL_TO}",
                        subject: "🧪 TEST COMPLETE - APPROVAL REQUIRED",
                        mimeType: 'text/html',

                        body: """
<h2>🧪 TEST ENVIRONMENT REPORT</h2>

<h3>🔐 CVE Summary</h3>
<pre>${env.TEST_CVE_SUMMARY}</pre>

<h3>🛠 Actions</h3>
<ul>
<li>Backup created</li>
<li>Patches applied</li>
<li>Trivy scan completed</li>
</ul>

<h3>🚦 Approve PROD Deployment</h3>

<a href="${approvalLink}" style="padding:10px 14px;background:#28a745;color:white;text-decoration:none;">
👉 APPROVE PRODUCTION
</a>
""",

                        attachmentsPattern: """
trivy-test.html,
trivy-test.json
"""
                    )
                }
            }
        }

        // =====================================================
        // PROD Approval Gate
        // =====================================================
        stage('PROD Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve PRODUCTION deployment?"
                }
            }
        }

        // =====================================================
        // PROD Backup + Patch
        // =====================================================
        stage('PROD Patch + Backup') {
            steps {
                sh """
                echo "Backup PROD"
                docker commit ${CONTAINER_PROD} ${BACKUP_IMAGE_PROD} || true

                echo "Patch PROD"
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=prod"
                """
            }
        }

        // =====================================================
        // PROD Trivy Scan (BLOCKING)
        // =====================================================
        stage('PROD Trivy Scan') {
            steps {
                sh """
                trivy image \
                    --exit-code 1 \
                    --severity HIGH,CRITICAL \
                    --format json \
                    -o trivy-prod.json \
                    ${CONTAINER_PROD}

                trivy image \
                    --format template \
                    --template "@contrib/html.tpl" \
                    -o trivy-prod.html \
                    ${CONTAINER_PROD}
                """
            }
        }

        // =====================================================
        // PROD Parse CVE
        // =====================================================
        stage('Parse PROD CVE') {
            steps {
                script {

                    if (!fileExists("trivy-prod.json")) {
                        env.PROD_CVE_SUMMARY = "No scan data available"
                        return
                    }

                    def json = readFile("trivy-prod.json")
                    def parsed = new JsonSlurper().parseText(json)

                    int critical = 0
                    int high = 0
                    int medium = 0
                    int low = 0

                    parsed.Results.each { r ->
                        r.Vulnerabilities?.each { v ->
                            switch(v.Severity) {
                                case "CRITICAL": critical++; break
                                case "HIGH": high++; break
                                case "MEDIUM": medium++; break
                                case "LOW": low++; break
                            }
                        }
                    }

                    env.PROD_CVE_SUMMARY = """
CRITICAL: ${critical}
HIGH: ${high}
MEDIUM: ${medium}
LOW: ${low}
"""
                }
            }
        }

        // =====================================================
        // PROD Email Report
        // =====================================================
        stage('Send PROD Report') {
            steps {
                emailext(
                    to: "${params.EMAIL_TO}",
                    subject: "🏭 PROD DEPLOYMENT REPORT",
                    mimeType: 'text/html',

                    body: """
<h2>🏭 PROD DEPLOYMENT COMPLETE</h2>

<h3>🔐 CVE Summary</h3>
<pre>${env.PROD_CVE_SUMMARY}</pre>

<h3>🚦 Policy</h3>
<p>HIGH/CRITICAL BLOCKED in production</p>
""",

                    attachmentsPattern: """
trivy-prod.html,
trivy-prod.json
"""
                )
            }
        }
    }

    // =====================================================
    // ROLLBACK
    // =====================================================
    post {
        failure {
            sh """
            docker stop ${CONTAINER_TEST} || true
            docker rm ${CONTAINER_TEST} || true
            docker run -d --name ${CONTAINER_TEST} ${BACKUP_IMAGE_TEST} || true

            docker stop ${CONTAINER_PROD} || true
            docker rm ${CONTAINER_PROD} || true
            docker run -d --name ${CONTAINER_PROD} ${BACKUP_IMAGE_PROD} || true
            """

            emailext(
                to: "${params.EMAIL_TO}",
                subject: "❌ PIPELINE FAILED - ROLLBACK DONE",
                body: "Rollback executed. Check Jenkins logs."
            )
        }
    }
}
