pipeline {
    agent any

    parameters {
        string(name: 'EMAIL_TO', defaultValue: 'susan.joffin@gmail.com', description: 'Notification Email')
        choice(name: 'ENV', choices: ['all', 'test', 'prod'], description: 'Target environment')
        booleanParam(name: 'RUN_PATCH', defaultValue: true, description: 'Run patching after scan')
    }

    environment {
        ANSIBLE_DIR = "gitops-infrastructure-automation-platform/infrastructure/ansible"
    }

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    sh """
                    ansible-playbook \
                    -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                    ${ANSIBLE_DIR}/scan.yml \
                    --extra-vars "env=${params.ENV}"
                    """
                }
            }
        }

        stage('Generate Status') {
            steps {
                script {
                    echo "Scan completed. Preparing pipeline decision flow..."
                    env.PATCH_FOUND = "true"   // replace later with real logic if needed
                }
            }
        }

        stage('Notify Scan Complete') {
            steps {
                emailext(
                    to: "${params.EMAIL_TO}",
                    subject: "SCAN COMPLETED - ${params.ENV}",
                    body: "Security scan completed. Check Jenkins logs for report."
                )
            }
        }

        stage('Patch Test Environment') {
            when {
                expression { env.PATCH_FOUND == "true" && params.RUN_PATCH }
            }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patching.yml \
                --extra-vars "env=test"
                """
            }
        }

        stage('Validate Test Environment') {
            when {
                expression { env.PATCH_FOUND == "true" && params.RUN_PATCH }
            }
            steps {
                sh """
                echo "Running health checks on TEST environment..."
                sleep 5
                """
            }
        }

        stage('Test Approval Gate') {
            when {
                expression { env.PATCH_FOUND == "true" && params.RUN_PATCH }
            }
            steps {
                input message: "Test environment validated. Approve production patching?"
            }
        }

        stage('Patch Production') {
            when {
                expression { env.PATCH_FOUND == "true" && params.RUN_PATCH }
            }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patching.yml \
                --extra-vars "env=prod"
                """
            }
        }

        stage('Final Notification') {
            steps {
                emailext(
                    to: "${params.EMAIL_TO}",
                    subject: "PRODUCTION PATCH COMPLETED",
                    body: "Production patching completed successfully for ${params.ENV}"
                )
            }
        }
    }

    post {
        success {
            emailext(
                to: "${params.EMAIL_TO}",
                subject: "PIPELINE SUCCESS",
                body: "Security scan + patch workflow completed successfully."
            )
        }

        failure {
            emailext(
                to: "${params.EMAIL_TO}",
                subject: "PIPELINE FAILED",
                body: "Pipeline failed. Please check Jenkins logs immediately."
            )
        }
    }
}
