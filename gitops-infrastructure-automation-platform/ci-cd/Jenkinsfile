pipeline {
    agent any

    parameters {
        string(name: 'EMAIL_TO', defaultValue: 'susan.joffin@gmail.com', description: 'Notification email')
        choice(name: 'ENV', choices: ['test', 'prod', 'all'], description: 'Target environment')
    }

    triggers {
        cron('H/10 * * * *')
    }

    environment {
        ANSIBLE_DIR = "gitops-infrastructure-automation-platform/infrastructure/ansible"

        SCAN_REPORT = ""
        PATCH_REPORT = ""
        HIGH_VULN_FOUND = "false"

        APPROVAL_USER = ""
        APPROVAL_TIME = ""
    }

    stages {

        /* =========================
           CHECKOUT
        ========================= */
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        /* =========================
           SECURITY SCAN (TEST)
        ========================= */
        stage('Security Scan') {
            steps {
                script {
                    sh """
                    ansible-playbook \
                    -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                    ${ANSIBLE_DIR}/scan.yml \
                    --extra-vars "env=test"
                    """

                    script {
                        if (fileExists('scan_report.txt')) {
                            env.SCAN_REPORT = readFile('scan_report.txt')

                            if (env.SCAN_REPORT.toLowerCase().contains("high")) {
                                env.HIGH_VULN_FOUND = "true"
                                error "HIGH severity vulnerability found. Blocking pipeline."
                            }
                        } else {
                            env.SCAN_REPORT = "Scan report not found"
                        }
                    }
                }
            }
        }

        /* =========================
           EMAIL TEST SCAN REPORT
        ========================= */
        stage('Email Test Scan Report') {
            steps {
                emailext(
                    to: params.EMAIL_TO.trim(),
                    subject: "TEST SCAN REPORT",
                    mimeType: 'text/plain',
                    body: """
TEST Security Scan Completed.

SCAN REPORT:
----------------------------------------
${env.SCAN_REPORT}
----------------------------------------

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
"""
                )
            }
        }

        /* =========================
           PATCH TEST
        ========================= */
        stage('Patch Test Environment') {
            when {
                expression { env.HIGH_VULN_FOUND == "false" }
            }
            steps {
                script {
                    sh """
                    ansible-playbook \
                    -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                    ${ANSIBLE_DIR}/patch.yml \
                    --extra-vars "env=test"
                    """

                    script {
                        if (fileExists('patch_report.txt')) {
                            env.PATCH_REPORT = readFile('patch_report.txt')
                        } else {
                            env.PATCH_REPORT = "Patch report not found"
                        }
                    }
                }
            }
        }

        /* =========================
           EMAIL TEST SUCCESS + APPROVAL LINK
        ========================= */
        stage('Email Test Success + Approval') {
            when {
                expression { env.HIGH_VULN_FOUND == "false" }
            }
            steps {
                script {
                    def approvalLink = "${env.BUILD_URL}input"

                    emailext(
                        to: params.EMAIL_TO.trim(),
                        subject: "TEST SUCCESS - APPROVAL REQUIRED",
                        mimeType: 'text/plain',
                        body: """
TEST environment completed successfully.

SCAN REPORT:
----------------------------------------
${env.SCAN_REPORT}
----------------------------------------

PATCH REPORT:
----------------------------------------
${env.PATCH_REPORT}
----------------------------------------

Approve production deployment:
${approvalLink}
"""
                    )
                }
            }
        }

        /* =========================
           APPROVAL + AUDIT TRAIL
        ========================= */
        stage('Approval for Production') {
            when {
                expression { env.HIGH_VULN_FOUND == "false" }
            }
            steps {
                script {
                    env.APPROVAL_USER =
                        currentBuild.rawBuild.getCause(hudson.model.Cause$UserIdCause)?.userId ?: "auto"

                    env.APPROVAL_TIME = new Date().toString()

                    input message: "Approve production deployment?"
                }
            }
        }

        /* =========================
           PATCH PRODUCTION
        ========================= */
        stage('Patch Production') {
            when {
                expression { env.HIGH_VULN_FOUND == "false" }
            }
            steps {
                script {
                    sh """
                    ansible-playbook \
                    -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                    ${ANSIBLE_DIR}/patch.yml \
                    --extra-vars "env=prod"
                    """
                }
            }
        }

        /* =========================
           ROLLBACK ON FAILURE
        ========================= */
        stage('Rollback') {
            when {
                expression { currentBuild.currentResult == 'FAILURE' }
            }
            steps {
                script {
                    sh """
                    ansible-playbook \
                    -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                    ${ANSIBLE_DIR}/rollback.yml \
                    --extra-vars "env=prod"
                    """
                }
            }
        }
    }

    /* =========================
       EMAIL POST ACTIONS
    ========================= */
    post {

        success {
            emailext(
                to: params.EMAIL_TO.trim(),
                subject: "PRODUCTION SUCCESS",
                mimeType: 'text/plain',
                body: """
Production deployment successful.

APPROVAL DETAILS:
Approved By: ${env.APPROVAL_USER}
Approved At: ${env.APPROVAL_TIME}

SCAN:
${env.SCAN_REPORT}

PATCH:
${env.PATCH_REPORT}

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
"""
            )
        }

        failure {
            emailext(
                to: params.EMAIL_TO.trim(),
                subject: "PIPELINE FAILED / ROLLBACK",
                mimeType: 'text/plain',
                body: """
Pipeline failed or was blocked.

HIGH VULNERABILITY: ${env.HIGH_VULN_FOUND}

Rollback executed if production was impacted.

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}

Logs:
${env.BUILD_URL}
"""
            )
        }
    }
}
