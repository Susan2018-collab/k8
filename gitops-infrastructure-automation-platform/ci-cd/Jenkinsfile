import groovy.json.JsonSlurper

pipeline {
    agent any

    parameters {
        string(name: 'EMAIL_TO', defaultValue: 'susan.joffin@gmail.com', description: 'Notification Email')
    }

    environment {
        ANSIBLE_DIR = "gitops-infrastructure-automation-platform/infrastructure/ansible"
        CONTAINER_TEST = "mail-test"
        CONTAINER_PROD = "mail-prod"
    }

    stages {

        // =====================================================
        // 1. CHECKOUT
        // =====================================================
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // =====================================================
        // 2. INSTALL TRIVY
        // =====================================================
        stage('Install Trivy') {
            steps {
                sh """
                set -e
                if ! command -v trivy >/dev/null 2>&1; then
                    curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh \
                    | sh -s -- -b /usr/local/bin
                fi
                trivy --version
                """
            }
        }

        // =====================================================
        // 3. PRE TRIVY SCAN (BASELINE)
        // =====================================================
        stage('Trivy Pre Scan') {
            steps {
                sh """
                echo "Running PRE scan..."

                docker commit ${CONTAINER_TEST} mail-test:pre || true

                trivy image \
                  --format json \
                  -o trivy-pre.json \
                  mail-test:pre || true
                """
            }
        }

        // =====================================================
        // 4. RUN PATCH (ANSIBLE)
        // =====================================================
        stage('Run Patch (Ansible)') {
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=test"
                """
            }
        }

        // =====================================================
        // 5. POST TRIVY SCAN
        // =====================================================
        stage('Trivy Post Scan') {
            steps {
                sh """
                echo "Running POST scan..."

                docker commit ${CONTAINER_TEST} mail-test:post || true

                trivy image \
                  --format json \
                  -o trivy-post.json \
                  mail-test:post || true
                """
            }
        }

        // =====================================================
        // 6. COMPARE CVEs (PRE vs POST)
        // =====================================================
        stage('Compare CVEs') {
            steps {
                script {

                    def preFile = readFile('trivy-pre.json')
                    def postFile = readFile('trivy-post.json')

                    def pre = new JsonSlurper().parseText(preFile)
                    def post = new JsonSlurper().parseText(postFile)

                    int preCount = 0
                    int postCount = 0

                    pre.Results.each { r ->
                        r.Vulnerabilities?.each { preCount++ }
                    }

                    post.Results.each { r ->
                        r.Vulnerabilities?.each { postCount++ }
                    }

                    env.PRE_CVE = preCount.toString()
                    env.POST_CVE = postCount.toString()
                    env.DIFF = (preCount - postCount).toString()
                }
            }
        }

        // =====================================================
        // 7. EMAIL + APPROVAL
        // =====================================================
        stage('Send Report + Approval') {
            steps {
                script {

                    def approvalLink = "${env.BUILD_URL}input"

                    emailext(
                        to: "${params.EMAIL_TO}",
                        subject: "🧪 DEVSECOPS REPORT - TEST ENV",
                        mimeType: 'text/html',
                        body: """
<h2>🧪 Security Scan Report</h2>

<h3>📊 CVE Summary</h3>
<ul>
<li>Before Patch: ${env.PRE_CVE}</li>
<li>After Patch: ${env.POST_CVE}</li>
<li>Improvement: ${env.DIFF}</li>
</ul>

<h3>🚦 Approval Required for PROD</h3>

<a href="${approvalLink}" style="padding:10px;background:green;color:white;">
👉 APPROVE PRODUCTION
</a>
"""
                    )
                }
            }
        }

        // =====================================================
        // 8. PROD APPROVAL GATE
        // =====================================================
        stage('PROD Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve deployment to PRODUCTION?"
                }
            }
        }

    }

    // =====================================================
    // POST ACTIONS
    // =====================================================
    post {
        always {
            echo "Pipeline completed"
        }

        failure {
            emailext(
                to: "${params.EMAIL_TO}",
                subject: "❌ PIPELINE FAILED",
                body: "Check Jenkins logs. Rollback may be required."
            )
        }
    }
}
