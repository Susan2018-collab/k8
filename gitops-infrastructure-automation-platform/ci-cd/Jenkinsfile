pipeline {
    agent any

    triggers {
        cron('H/10 * * * *') // Every 10 minutes
    }

    parameters {
        choice(
            name: 'ENV',
            choices: ['test', 'prod'],
            description: 'Select environment (default = test)'
        )
    }

    environment {
        TEST_CONTAINER = "mail-test"
        PROD_CONTAINER = "mail-prod"
        EMAIL = "susan.joffin@gmail.com"
    }

    stages {

        stage('Init') {
            steps {
                script {
                    def isTimer = currentBuild.rawBuild.getCause(hudson.triggers.TimerTrigger$TimerTriggerCause)

                    if (isTimer) {
                        env.TARGET_ENV = "test"
                        echo "Auto-trigger → forcing TEST"
                    } else {
                        env.TARGET_ENV = params.ENV ?: "test"
                        echo "Manual trigger → ENV: ${env.TARGET_ENV}"
                    }
                }
            }
        }

        stage('PRE Scan') {
            steps {
                sh '''
                echo "Running PRE scan..."
                docker commit ${TEST_CONTAINER} mail-server:pre
                trivy image --severity CRITICAL,HIGH --format json -o trivy-pre.json mail-server:pre
                '''
            }
        }

        stage('Extract CVE Data') {
            steps {
                script {
                    env.CVE_COUNT = sh(
                        script: "jq '[.Results[].Vulnerabilities[]?] | length' trivy-pre.json",
                        returnStdout: true
                    ).trim()

                    env.CVE_LIST = sh(
                        script: "jq -r '.Results[].Vulnerabilities[]? | \"\\(.VulnerabilityID) - \\(.PkgName)\"' trivy-pre.json | head -20",
                        returnStdout: true
                    ).trim()

                    echo "CVE Count: ${env.CVE_COUNT}"
                }
            }
        }

        stage('Detect Upgradable Packages') {
            steps {
                script {
                    env.UPGRADE_COUNT = sh(
                        script: """
                        docker exec ${TEST_CONTAINER} bash -c "apt list --upgradable 2>/dev/null | wc -l"
                        """,
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Patch TEST') {
            when {
                expression { env.TARGET_ENV == 'test' }
            }
            steps {
                sh '''
                echo "Patching TEST..."
                docker exec ${TEST_CONTAINER} apt update
                docker exec ${TEST_CONTAINER} apt upgrade -y
                '''
            }
        }

        stage('Post Scan') {
            steps {
                sh '''
                docker commit ${TEST_CONTAINER} mail-server:post
                trivy image --severity CRITICAL,HIGH --format json -o trivy-post.json mail-server:post
                '''
            }
        }

        stage('Compare CVEs') {
            steps {
                script {
                    env.POST_CVE = sh(
                        script: "jq '[.Results[].Vulnerabilities[]?] | length' trivy-post.json",
                        returnStdout: true
                    ).trim()

                    echo "POST CVE Count: ${env.POST_CVE}"
                }
            }
        }

        stage('Approval Email') {
            steps {
                emailext(
                    to: "${EMAIL}",
                    subject: "APPROVAL REQUIRED - CVE PATCH REPORT",
                    body: """
PRE-CVE Count: ${env.CVE_COUNT}
POST-CVE Count: ${env.POST_CVE}
Upgradable Packages: ${env.UPGRADE_COUNT}

Top CVEs:
${env.CVE_LIST}

➡ Please approve PROD deployment in Jenkins if results are acceptable.
"""
                )
            }
        }

        stage('Manual Approval for PROD') {
            when {
                expression { env.TARGET_ENV == 'prod' }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: """
Approve PROD patch?

PRE-CVE: ${env.CVE_COUNT}
POST-CVE: ${env.POST_CVE}
Packages: ${env.UPGRADE_COUNT}
"""
                }
            }
        }

        stage('Backup PROD') {
            when {
                expression { env.TARGET_ENV == 'prod' }
            }
            steps {
                sh '''
                echo "Taking PROD backup..."
                docker commit ${PROD_CONTAINER} mail-prod:backup
                '''
            }
        }

        stage('Patch PROD') {
            when {
                expression { env.TARGET_ENV == 'prod' }
            }
            steps {
                sh '''
                echo "Patching PROD..."
                docker exec ${PROD_CONTAINER} apt update
                docker exec ${PROD_CONTAINER} apt upgrade -y
                '''
            }
        }

        stage('Verify PROD') {
            when {
                expression { env.TARGET_ENV == 'prod' }
            }
            steps {
                script {
                    def status = sh(
                        script: "docker exec ${PROD_CONTAINER} systemctl is-active exim || true",
                        returnStdout: true
                    ).trim()

                    if (status != "active") {
                        error("Service validation failed after patch")
                    }
                }
            }
        }

        stage('Rollback (if failure)') {
            when {
                expression { currentBuild.currentResult == 'FAILURE' && env.TARGET_ENV == 'prod' }
            }
            steps {
                sh '''
                echo "Rolling back PROD..."
                docker stop ${PROD_CONTAINER} || true
                docker rm ${PROD_CONTAINER} || true
                docker run -d --name ${PROD_CONTAINER} mail-prod:backup
                '''
            }
        }

        stage('PROD Success Email') {
            when {
                expression { env.TARGET_ENV == 'prod' }
            }
            steps {
                emailext(
                    to: "${EMAIL}",
                    subject: "PROD PATCH SUCCESS",
                    body: """
✅ PRODUCTION PATCH COMPLETED

CVE Before: ${env.CVE_COUNT}
CVE After: ${env.POST_CVE}
Packages Upgraded: ${env.UPGRADE_COUNT}

Status: SUCCESS
"""
                )
            }
        }
    }

    post {
        failure {
            emailext(
                to: "${EMAIL}",
                subject: "PIPELINE FAILED",
                body: """
❌ Pipeline Failed

Check Jenkins logs immediately.

Environment: ${env.TARGET_ENV}
"""
            )
        }
    }
}
