pipeline {
    agent any

    parameters {
        string(name: 'EMAIL_TO', defaultValue: 'susan.joffin@gmail.com', description: 'Notification Email')
        choice(name: 'ENV', choices: ['test', 'prod', 'all'], description: 'Target Environment')
    }

    triggers {
        cron('H 2 * * *')
    }

    environment {
        ANSIBLE_DIR = "gitops-infrastructure-automation-platform/infrastructure/ansible"

        // 🔥 NEW: Docker rollback config
        CONTAINER_TEST = "mail-test"
        CONTAINER_PROD = "mail-prod"

        BACKUP_IMAGE_TEST = "mail-test-backup"
        BACKUP_IMAGE_PROD = "mail-prod-backup"
    }

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Security Scan') {
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/scan.yml \
                --extra-vars "env=${params.ENV} email_to=${params.EMAIL_TO}"
                """
            }
        }

        stage('Evaluate Scan Result') {
            steps {
                script {
                    echo "Evaluating scan results..."
                    env.PATCH_FOUND = "true"
                }
            }
        }

        stage('Archive Scan Reports') {
            steps {
                archiveArtifacts artifacts: '**/scan_*.txt', allowEmptyArchive: true
            }
        }

        // =====================================================
        // 🔥 BACKUP TEST ENV
        // =====================================================
        stage('Backup TEST Environment') {
            when { expression { env.PATCH_FOUND == "true" } }
            steps {
                sh """
                echo "Creating TEST backup..."
                docker commit ${CONTAINER_TEST} ${BACKUP_IMAGE_TEST} || true
                """
            }
        }

        stage('Patch TEST Environment') {
            when { expression { env.PATCH_FOUND == "true" } }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=test"
                """
            }
        }

        stage('Notify TEST Success') {
            when { expression { env.PATCH_FOUND == "true" } }
            steps {
                emailext(
                    to: "${params.EMAIL_TO}",
                    subject: "✅ TEST PATCH SUCCESS",
                    body: "Test patching completed successfully."
                )
            }
        }

        stage('Send Approval Email') {
            when { expression { env.PATCH_FOUND == "true" } }
            steps {
                script {
                    def approvalLink = "${env.BUILD_URL}input"

                    emailext(
                        to: "${params.EMAIL_TO}",
                        subject: "⚠️ APPROVAL REQUIRED",
                        mimeType: 'text/html',
                        body: """
                        <h2>Approve Production Deployment</h2>
                        <a href="${approvalLink}">Click to Approve</a>
                        """
                    )
                }
            }
        }

        stage('Approval for Production') {
            when { expression { env.PATCH_FOUND == "true" } }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve deployment to PRODUCTION?"
                }
            }
        }

        // =====================================================
        // 🔥 BACKUP PROD ENV
        // =====================================================
        stage('Backup PROD Environment') {
            when { expression { env.PATCH_FOUND == "true" } }
            steps {
                sh """
                echo "Creating PROD backup..."
                docker commit ${CONTAINER_PROD} ${BACKUP_IMAGE_PROD} || true
                """
            }
        }

        stage('Patch PROD Environment') {
            when { expression { env.PATCH_FOUND == "true" } }
            steps {
                sh """
                ansible-playbook \
                -i ${ANSIBLE_DIR}/inventory/hosts.ini \
                ${ANSIBLE_DIR}/patch.yml \
                --extra-vars "env=prod"
                """
            }
        }

        stage('Archive Patch Reports') {
            steps {
                archiveArtifacts artifacts: '**/patch_report_*.txt', allowEmptyArchive: true
            }
        }
    }

    // =====================================================
    // 🔥 POST SECTION WITH ROLLBACK
    // =====================================================
    post {

        always {
            echo "Pipeline completed. Email target: ${params.EMAIL_TO}"
        }

        success {
            emailext(
                to: "${params.EMAIL_TO}",
                subject: "✅ PIPELINE SUCCESS",
                body: "Pipeline completed successfully."
            )
        }

        // 🔥🔥🔥 MAIN ROLLBACK LOGIC
        failure {
            script {
                echo "❌ FAILURE DETECTED - STARTING ROLLBACK"

                sh """
                echo "Rolling back TEST environment..."
                docker stop ${CONTAINER_TEST} || true
                docker rm ${CONTAINER_TEST} || true
                docker run -d --name ${CONTAINER_TEST} -p 2525:25 ${BACKUP_IMAGE_TEST} || true

                echo "Rolling back PROD environment..."
                docker stop ${CONTAINER_PROD} || true
                docker rm ${CONTAINER_PROD} || true
                docker run -d --name ${CONTAINER_PROD} -p 2626:25 ${BACKUP_IMAGE_PROD} || true

                sleep 10

                echo "Validating rollback..."
                docker exec ${CONTAINER_TEST} service exim4 start || true
                docker exec ${CONTAINER_PROD} service exim4 start || true
                """

                emailext(
                    to: "${params.EMAIL_TO}",
                    subject: "⚠️ ROLLBACK EXECUTED",
                    body: "Pipeline failed. Rollback executed successfully."
                )
            }
        }
    }
}
